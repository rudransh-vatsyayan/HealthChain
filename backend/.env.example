PORT=3001
# Local Docker: mongodb://localhost:27017/healthchain
# Vercel + persistent DB: MongoDB Atlas connection string, e.g.
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/healthchain?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/healthchain
# Optional: longer timeout for Atlas (default 10s on Vercel, 1.5s locally)
# MONGO_TIMEOUT_MS=10000
JWT_SECRET=healthchain_super_secret_key_change_in_production
# Local: http://localhost:5173 — Production: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173
# In-memory demo store (auto-enabled on Vercel when MONGO_URI is local/unset)
# USE_MEMORY_DB=true
# Set to false after demo users exist in Atlas if you do not want seed on cold starts
# AUTO_SEED=true
